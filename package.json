{
  "name": "kbase-fe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3000 --strictPort",
