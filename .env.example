# Public browser config only. Never place Gemini/JWT/SMTP/DB/MinIO secrets here.
VITE_API_BASE_URL=/api/v1
# Vite development server only, not a browser secret; owner supplies actual BE endpoint.
KBASE_FE_PROXY_TARGET=http://localhost:8080
VITE_ENABLE_MOCKS=false
# Frontend display limits must be confirmed against the target backend config.
VITE_UPLOAD_DOCUMENT_MAX_BYTES=52428800
VITE_UPLOAD_IMAGE_MAX_BYTES=20971520
VITE_UPLOAD_VIDEO_MAX_BYTES=524288000
VITE_UPLOAD_BATCH_MAX_FILES=10
# Multipart request limit includes boundaries and metadata; do not treat this as sum-of-file allowance.
VITE_UPLOAD_REQUEST_MAX_BYTES=524288000
VITE_AI_MAX_MESSAGE_CHARS=8000
